DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kassen_app
DB_USER=kassen
DB_PASS=change-me

# Europe/Berlin drives the daily/hourly report boundaries — keep this fixed regardless of server locale.
APP_TIMEZONE=Europe/Berlin

# Set to 1 behind HTTPS in production so the access cookie gets the Secure flag.
APP_HTTPS=0

# Used to build the link in "forgot code" recovery emails. Recommended: set this to your real
# domain (e.g. https://pos.example.com) rather than relying on the request's Host header — a
# misconfigured server could otherwise let someone spoof the Host and get a phishing link mailed
# to your own recovery address. Optional; falls back to the request's Host header if unset.
APP_URL=

# SMTP for outgoing report emails ("Per E-Mail senden" on Journal/Auswertungen/Z-Bon — src/Mailer.php,
# a small dependency-free SMTP client, no Composer/vendor). Leave SMTP_HOST empty to disable email
# sending entirely — the send buttons then show a clear "kein Mailserver konfiguriert" error instead
# of silently failing or falling back to anything else. Recipients are set separately, in Verwaltung
# -> Einstellungen ("Berichts-E-Mail"), not here.
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS on a plain connection (typical for port 587), ssl = implicit TLS from the first
# byte (typical for port 465), none = unencrypted (only for a mail relay on localhost/private network).
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
# Must be an address your SMTP provider allows this account to send as, or most providers reject
# or spam-flag the message. Falls back to no visible display name if SMTP_FROM_NAME is left empty.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Festkasse
